# Copy to .env and adjust. All feature flags default to false when unset.

DATABASE_URL=postgresql+psycopg://resume_tailor:resume_tailor@localhost:5432/resume_tailor
CORS_ORIGINS=["http://localhost:5173"]

# Opt-in LLM features — off by default, the app runs fully without them.
# Each one also needs an Anthropic API key (below) to actually run once enabled.
ENABLE_RESUME_IMPORT=false
ENABLE_LLM_ENHANCE=false
ENABLE_COVER_LETTER=false

# Get one at https://console.anthropic.com/ — required for import/enhance/cover letters.
# ANTHROPIC_API_KEY=sk-ant-...
